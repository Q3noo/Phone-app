<?xml version="1.0" encoding="utf-8"?>
<!-- Roll wheels: month and day, then hour, minute and AM/PM. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/wheel_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorPrimary" />

    <LinearLayout
        android:id="@+id/date_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date_label"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/editor_reminder_box"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <NumberPicker
                android:id="@+id/wheel_month"
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_weight="1.4"
                android:contentDescription="@string/wheel_month"
                android:theme="@style/ThemeOverlay.Notelet.Wheel" />

            <NumberPicker
                android:id="@+id/wheel_day"
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:contentDescription="@string/wheel_day"
                android:theme="@style/ThemeOverlay.Notelet.Wheel" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/time_label"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/editor_reminder_box"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <NumberPicker
            android:id="@+id/wheel_hour"
            android:layout_width="0dp"
            android:layout_height="144dp"
            android:layout_weight="1"
            android:contentDescription="@string/wheel_hour"
            android:theme="@style/ThemeOverlay.Notelet.Wheel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text=":"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <NumberPicker
            android:id="@+id/wheel_minute"
            android:layout_width="0dp"
            android:layout_height="144dp"
            android:layout_weight="1"
            android:contentDescription="@string/wheel_minute"
            android:theme="@style/ThemeOverlay.Notelet.Wheel" />

        <NumberPicker
            android:id="@+id/wheel_ampm"
            android:layout_width="0dp"
            android:layout_height="144dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:contentDescription="@string/wheel_ampm"
            android:theme="@style/ThemeOverlay.Notelet.Wheel" />
    </LinearLayout>
</LinearLayout>
